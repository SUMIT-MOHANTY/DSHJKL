# GitHub Actions staging
cat <<'EOF' > .github/workflows/staging.yml
name: Deploy Staging
on:
  push:
    branches: [main]
    paths:
      - backend/**
      - frontend/**
  workflow_dispatch:

env:
  AWS_REGION: us-east-1
  ECR_BACKEND: CHANGEME.dkr.ecr.us-east-1.amazonaws.com/captive-portal-staging-backend
  ECR_FRONTEND: CHANGEME.dkr.ecr.us-east-1.amazonaws.com/captive-portal-staging-frontend

jobs:
  backend:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_OIDC_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}
      - uses: aws-actions/amazon-ecr-login@v2
      - name: Build & push backend
        run: |
          docker build -f backend/Dockerfile -t $ECR_BACKEND:staging-$GITHUB_SHA backend
          docker push $ECR_BACKEND:staging-$GITHUB_SHA

  frontend:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 18
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_OIDC_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}
      - uses: aws-actions/amazon-ecr-login@v2
      - name: Build & push frontend
        run: |
          npm --prefix frontend ci
          npm --prefix frontend run build
          docker build -t $ECR_FRONTEND:staging-$GITHUB_SHA frontend
          docker push $ECR_FRONTEND:staging-$GITHUB_SHA

  deploy:
    needs: [backend, frontend]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_OIDC_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}
      - name: Deploy staging
        run: |
          terraform -chdir=terraform workspace select staging || terraform -chdir=terraform workspace new staging
          terraform -chdir=terraform plan -var-file=environments/staging.tfvars -out=tfplan
          terraform -chdir=terraform apply tfplan
EOF

# GitHub Actions production
cat <<'EOF' > .github/workflows/production.yml
name: Deploy Production
on:
  workflow_dispatch:
    inputs:
      tag:
        description: 'Git tag to deploy' 
        required: true

env:
  AWS_REGION: us-east-1
  ECR_BACKEND: CHANGEME.dkr.ecr.us-east-1.amazonaws.com/captive-portal-prod-backend
  ECR_FRONTEND: CHANGEME.dkr.ecr.us-east-1.amazonaws.com/captive-portal-prod-frontend

jobs:
  build-backend:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.inputs.tag }}
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_PROD_OIDC_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}
      - uses: aws-actions/amazon-ecr-login@v2
      - name: Build & push backend
        run: |
          docker build -f backend/Dockerfile -t $ECR_BACKEND:${{ github.event.inputs.tag }} backend
          docker push $ECR_BACKEND:${{ github.event.inputs.tag }}

  build-frontend:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.inputs.tag }}
      - uses: actions/setup-node@v4
        with:
          node-version: 18
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_PROD_OIDC_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}
      - uses: aws-actions/amazon-ecr-login@v2
      - name: Build & push frontend
        run: |
          npm --prefix frontend ci
          npm --prefix frontend run build
          docker build -t $ECR_FRONTEND:${{ github.event.inputs.tag }} frontend
          docker push $ECR_FRONTEND:${{ github.event.inputs.tag }}

  deploy:
    needs: [build-backend, build-frontend]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.inputs.tag }}
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_PROD_OIDC_ROLE_ARN }}
          aws-region: ${{ env.AWS_REGION }}
      - name: Deploy production
        run: |
          terraform -chdir=terraform workspace select production || terraform -chdir=terraform workspace new production
          terraform -chdir=terraform plan -var-file=environments/production.tfvars -out=tfplan
          terraform -chdir=terraform apply tfplan
EOF

