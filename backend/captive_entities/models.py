from rest_framework import viewsets, status
from rest_framework.decorators import action
from rest_framework.response import Response
from .models import CaptiveEntity
from .serializers import CaptiveEntitySerializer

class CaptiveEntityViewSet(viewsets.ModelViewSet):
    queryset = CaptiveEntity.objects.all()
    serializer_class = CaptiveEntitySerializer
    
    @action(detail=True, methods=['post'])
    def archive(self, request, pk=None):
        entity = self.get_object()
        entity.status = 'archived'
        entity.save()
        return Response({'status': 'archived', 'id': entity.id})
EOF
