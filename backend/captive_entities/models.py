        response = self.client.post('/api/captive-entities/', data)
        self.assertEqual(response.status_code, status.HTTP_201_CREATED)
        self.assertEqual(response.data['total_capital'], 1500000)
        
    def test_archive_entity(self):
        entity = CaptiveEntity.objects.create(name='Test', minimum_capital=100, surplus=50)
        response = self.client.post(f'/api/captive-entities/{entity.id}/archive/')
        self.assertEqual(response.status_code, status.HTTP_200_OK)
