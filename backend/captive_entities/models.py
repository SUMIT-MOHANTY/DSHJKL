from django.db import models
from django.core.validators import MinValueValidator

class CaptiveEntity(models.Model):
    STATUS_CHOICES = [
        ('active', 'Active'),
        ('pending', 'Pending'),
        ('archived', 'Archived'),
    ]
    
    name = models.CharField(max_length=255)
    status = models.CharField(max_length=10, choices=STATUS_CHOICES, default='pending')
    minimum_capital = models.DecimalField(max_digits=15, decimal_places=2, validators=[MinValueValidator(0)])
    surplus = models.DecimalField(max_digits=15, decimal_places=2, validators=[MinValueValidator(0)])
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)
    
    @property
    def total_capital(self):
        return self.minimum_capital + self.surplus
    
    def __str__(self):
        return f"{self.name} ({self.status})"
EOF
