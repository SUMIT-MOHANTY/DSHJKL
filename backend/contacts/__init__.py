# 3. models.py
cat <<'EOF' > "$CONTACTS_DIR/models.py"
from django.db import models
from captive_entities.models import CaptiveEntity

class Contact(models.Model):
    ROLE_CHOICES = [
        ('shareholder', 'Shareholder'),
        ('director', 'Director'),
        ('broker', 'Broker'),
        ('insured_entity', 'Insured Entity'),
    ]
    
    id = models.AutoField(primary_key=True)
    first_name = models.CharField(max_length=100)
    last_name = models.CharField(max_length=100)
    email = models.EmailField(unique=True)
    phone = models.CharField(max_length=50, blank=True)
    role = models.CharField(max_length=20, choices=ROLE_CHOICES)
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)
    
    # Related via ContactCaptive M2M
    captives = models.ManyToManyField(
        CaptiveEntity,
        through='ContactCaptive',
        related_name='contacts'
    )
    
    class Meta:
        db_table = 'contacts_contact'
        ordering = ['last_name', 'first_name']
    
    def __str__(self):
        return f"{self.first_name} {self.last_name} ({self.role})"


class ContactCaptive(models.Model):
    id = models.AutoField(primary_key=True)
    contact = models.ForeignKey(
        Contact,
        on_delete=models.CASCADE,
        related_name='contact_captives'
    )
    captive = models.ForeignKey(
        CaptiveEntity,
        on_delete=models.CASCADE,
        related_name='contact_captives'
    )
    
    class Meta:
        db_table = 'contacts_contactcaptive'
        unique_together = ('contact', 'captive')
EOF

# 4. serializers.py
cat <<'EOF' > "$CONTACTS_DIR/serializers.py"
from rest_framework import serializers
from .models import Contact, ContactCaptive
from captive_entities.serializers import CaptiveEntitySerializer

class ContactSerializer(serializers.ModelSerializer):
    class Meta:
        model = Contact
        fields = [
            'id',
            'first_name',
            'last_name',
            'email',
            'phone',
            'role',
            'created_at',
            'updated_at',
        ]
        read_only_fields = ['created_at', 'updated_at']


# Nested serializer used for reverse captive -> contacts listing
class ContactWithCaptivesSerializer(ContactSerializer):
    captives = CaptiveEntitySerializer(many=True, read_only=True)
    
    class Meta(ContactSerializer.Meta):
        fields = ContactSerializer.Meta.fields + ['captives']
EOF

# 5. views.py
cat <<'EOF' > "$CONTACTS_DIR/views.py"
from rest_framework import viewsets
from rest_framework.decorators import action
from rest_framework.response import Response
from .models import Contact
from .serializers import ContactSerializer

class ContactViewSet(viewsets.ModelViewSet):
    queryset = Contact.objects.all().order_by('last_name', 'first_name')
    serializer_class = ContactSerializer
    
    @action(detail=False, methods=['get'], url_path='by-captive/(?P<captive_id>[^/.]+)')
    def by_captive(self, request, captive_id=None):
        contacts = self.queryset.filter(
            contact_captives__captive_id=captive_id
        ).distinct()
        serializer = self.get_serializer(contacts, many=True)
        return Response(serializer.data)
EOF

